            </Properties>
        </Characteristic>
        <Characteristic name="Reset Reason" type="com.hpcn105.characteristic.reset_reason">
            <InformativeText>nRF52 POWER-RESETREAS register captured at boot, then cleared. 0 = cold power-on; bit 1 (value 2) = the hardware watchdog fired, i.e. the previous firmware run wedged and self-recovered. Static per boot.</InformativeText>
            <Requirement>Mandatory</Requirement>
            <Properties>
                <Read>Mandatory</Read>
                <Write>Excluded</Write>
                <WriteWithoutResponse>Excluded</WriteWithoutResponse>
                <SignedWrite>Excluded</SignedWrite>
                <ReliableWrite>Excluded</ReliableWrite>
                <Notify>Excluded</Notify>
                <Indicate>Excluded</Indicate>
                <WritableAuxiliaries>Excluded</WritableAuxiliaries>
                <Broadcast>Excluded</Broadcast>
            </Properties>
        </Characteristic>
        <Characteristic name="Received Frame Count" type="com.hpcn105.characteristic.rx_count">
            <InformativeText>Number of valid CN105 frames received since boot (in the diagnostic sniffer build: raw bytes instead). uint32 LE. A climbing count is the ground truth that the bus wiring and levels are good.</InformativeText>
            <Requirement>Mandatory</Requirement>
            <Properties>
