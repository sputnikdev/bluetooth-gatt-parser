<?xml version="1.0" encoding="utf-8"?>
<!--
  HP-CN105 heat pump bridge node (nRF52840 on the Mitsubishi CN105 bus, tools/heatpump_node_zephyr/).
  Write-only function command: byte 0 = function code (0xFF triggers a full function-table re-fetch,
  otherwise 1..28), byte 1 = value (1..3). The node applies it over CN105 and refreshes Function Settings.
  Registered by short UUID 9E7E020E (full 9e7e020e-1234-4cde-2025-0a0b0c0d0e0f).
-->
<Characteristic xsi:noNamespaceSchemaLocation="http://schemas.bluetooth.org/Documents/characteristic.xsd"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="Function Command"
                type="com.hpcn105.characteristic.function_command"
                uuid="9E7E020E" last-modified="2026-07-12" approved="No">
    <InformativeText>
        <Abstract>
            Write-only. Byte 0 = function code (0xFF = re-fetch the whole table, else 1..28),
            byte 1 = value (1..3).
        </Abstract>
    </InformativeText>
    <Value>
        <Field name="Function Code">
            <Requirement>Mandatory</Requirement>
            <Format>uint8</Format>
        </Field>
        <Field name="Value">
            <Requirement>Mandatory</Requirement>
            <Format>uint8</Format>
        </Field>
    </Value>
</Characteristic>
