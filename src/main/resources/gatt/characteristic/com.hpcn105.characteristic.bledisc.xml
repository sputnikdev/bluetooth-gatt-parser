<?xml version="1.0" encoding="utf-8"?>
<!--
  HP-CN105 heat pump bridge node (tools/heatpump_node_zephyr/). Health/reliability counter.
  Count of BLE central (openHAB) disconnect events since boot. This is the node<->openHAB link,
  distinct from the CN105 node<->heatpump serial link counters. Rising = a flaky BLE link.
  Registered by short UUID 9E7E0215 (full 9e7e0215-1234-4cde-2025-0a0b0c0d0e0f).
-->
<Characteristic xsi:noNamespaceSchemaLocation="http://schemas.bluetooth.org/Documents/characteristic.xsd"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="BLE Disconnects"
                type="com.hpcn105.characteristic.bledisc"
                uuid="9E7E0215" last-modified="2026-07-13" approved="No">
    <InformativeText><Abstract>Count of BLE central (openHAB) disconnects since boot. Node&lt;-&gt;openHAB link health.</Abstract></InformativeText>
    <Value>
        <Field name="BLE Disconnects">
            <Requirement>Mandatory</Requirement>
            <Format>uint32</Format>
        </Field>
    </Value>
</Characteristic>
