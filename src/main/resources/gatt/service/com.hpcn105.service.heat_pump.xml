        <Characteristic name="CN105 Link" type="com.hpcn105.characteristic.cn105_link">
            <InformativeText>State of the serial link to the heat pump: handshake completed and frames still arriving (30 s receive watchdog).</InformativeText>
            <Requirement>Mandatory</Requirement>
            <Properties>
                <Read>Mandatory</Read>
                <Write>Excluded</Write>
