                <Indicate>Excluded</Indicate>
                <WritableAuxiliaries>Excluded</WritableAuxiliaries>
                <Broadcast>Excluded</Broadcast>
            </Properties>
        </Characteristic>
        <Characteristic name="Function Settings" type="com.hpcn105.characteristic.functions">
