        </Characteristic>
        <Characteristic name="Function Command" type="com.hpcn105.characteristic.function_command">
            <InformativeText>Write-only. Byte 0 = function code (0xFF re-fetches the whole table, else 1..28), byte 1 = value (1..3).</InformativeText>
